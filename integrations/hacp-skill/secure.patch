diff --git a/src/secure.rs b/src/secure.rs
new file mode 100644
index 0000000..e28c640
--- /dev/null
+++ b/src/secure.rs
@@ -0,0 +1,270 @@
+//! Optional transport glue. No keys, signatures, nonces, or counters are handled here.
+use crate::store::*;
+use anyhow::{Result, ensure};
+use hacp::{
+    secure::{SecureError, workflow::Workflow},
+    v2::Envelope,
+};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::BTreeMap,
+    fs,
+    io::Read,
+    os::unix::fs::{MetadataExt, OpenOptionsExt, PermissionsExt},
+    path::{Path, PathBuf},
+};
+
+pub fn configured(root: &Path) -> Result<bool> {
+    let requested = std::env::var("HACP_SECURE").is_ok_and(|v| v == "1");
+    let marker = root.join(".hacp/secure-required");
+    if requested || marker.exists() {
+        ensure!(
+            requested,
+            "secure session requires HACP_SECURE=1; plaintext downgrade refused"
+        );
+        ensure!(
+            std::env::var_os("HACP_SECURE_SOCKET").is_some(),
+            "secure guardian socket is required"
+        );
+        if !marker.exists() {
+            ensure!(
+                !root.join(".hacp/session.json").exists(),
+                "enable secure transport at session start"
+            );
+            atomic(&marker, b"required\n")?;
+        }
+        Ok(true)
+    } else {
+        Ok(false)
+    }
+}
+fn workflow(st: &Store, s: &Snapshot) -> Result<Workflow> {
+    let socket = std::env::var_os("HACP_SECURE_SOCKET").ok_or(SecureError::GuardianUnavailable)?;
+    Ok(Workflow::new(
+        Path::new(&socket),
+        &urn(&st.peer),
+        &urn(other(&st.peer)),
+        &s.session.session_id,
+    )?)
+}
+fn private_dir(path: &Path) -> Result<()> {
+    let m = fs::symlink_metadata(path)?;
+    ensure!(
+        m.is_dir()
+            && !m.file_type().is_symlink()
+            && m.uid() == unsafe { libc::geteuid() }
+            && m.mode() & 0o077 == 0,
+        "agent state must be a private owned directory"
+    );
+    Ok(())
+}
+fn state(st: &Store, s: &Snapshot) -> Result<PathBuf> {
+    let base =
+        PathBuf::from(std::env::var_os("HACP_SECURE_STATE").ok_or_else(|| {
+            anyhow::anyhow!("HACP_SECURE_STATE agent-local directory is required")
+        })?);
+    private_dir(&base)?;
+    let base = base.canonicalize()?;
+    ensure!(
+        !base.starts_with(&st.root),
+        "agent state must be outside shared project"
+    );
+    ensure!(
+        s.session.session_id.starts_with("s-")
+            && s.session.session_id[2..]
+                .bytes()
+                .all(|b| b.is_ascii_hexdigit()),
+        "invalid session id"
+    );
+    let key = format!(
+        "{:x}",
+        Sha256::digest(st.root.as_os_str().as_encoded_bytes())
+    );
+    let mut dir = base;
+    for part in [
+        key.as_str(),
+        s.session.session_id.as_str(),
+        st.peer.as_str(),
+    ] {
+        dir.push(part);
+        if !dir.exists() {
+            fs::create_dir(&dir)?;
+            fs::set_permissions(&dir, fs::Permissions::from_mode(0o700))?;
+        }
+        private_dir(&dir)?;
+    }
+    Ok(dir)
+}
+fn cache(st: &Store, s: &Snapshot) -> Result<PathBuf> {
+    let dir = state(st, s)?.join("received");
+    if !dir.exists() {
+        fs::create_dir(&dir)?;
+        fs::set_permissions(&dir, fs::Permissions::from_mode(0o700))?;
+    }
+    private_dir(&dir)?;
+    Ok(dir)
+}
+pub fn ingest(st: &Store, s: &mut Snapshot) -> Result<bool> {
+    if !st.secure {
+        return Ok(false);
+    }
+    ensure!(s.secure_mode, "secure session mode mismatch");
+    let cache = cache(st, s)?;
+    let previous = s.secure_received.clone();
+    s.secure_received.clear();
+    if cache.exists() {
+        for entry in fs::read_dir(&cache)? {
+            let mut bytes = Vec::new();
+            fs::OpenOptions::new()
+                .read(true)
+                .custom_flags(libc::O_NOFOLLOW)
+                .open(entry?.path())?
+                .take(16 * 1024 * 1024 + 1)
+                .read_to_end(&mut bytes)?;
+            ensure!(bytes.len() <= 16 * 1024 * 1024, "oversized delivery cache");
+            let m: Envelope = serde_json::from_slice(&bytes)?;
+            m.validate()?;
+            ensure!(
+                m.from == urn(other(&st.peer))
+                    && m.to == urn(&st.peer)
+                    && m.session_id == s.session.session_id,
+                "invalid delivery cache"
+            );
+            s.secure_received
+                .entry(st.peer.clone())
+                .or_default()
+                .insert(m.message_id.clone(), m);
+        }
+    }
+    let inbox = workflow(st, s)?.receive()?;
+    let mut errors = inbox.errors;
+    for m in &inbox.messages {
+        let result = (|| -> Result<()> {
+            let mut received_view = visible(s, &st.peer);
+            received_view.processed = received_view
+                .messages
+                .iter()
+                .map(|m| m.message_id.clone())
+                .collect();
+            if let Some(old) = received_view
+                .messages
+                .iter()
+                .find(|old| old.message_id == m.message_id)
+            {
+                ensure!(old == m, "conflicting authenticated message id");
+            }
+            crate::messages::receive(&mut received_view, &st.peer, m, true)?;
+            // Save validated deliveries before surfacing any other failure.
+            atomic(
+                &cache.join(format!("{}.json", m.message_id)),
+                &serde_json::to_vec(m)?,
+            )?;
+            s.secure_received
+                .entry(st.peer.clone())
+                .or_default()
+                .insert(m.message_id.clone(), m.clone());
+            Ok(())
+        })();
+        if result.is_err() {
+            errors.push(SecureError::SchemaViolation);
+        }
+    }
+    for e in errors {
+        if e != SecureError::ReplayRejected {
+            return Err(e.into());
+        }
+    }
+    Ok(s.secure_received != previous)
+}
+pub fn stage(st: &Store, s: &Snapshot) -> Result<()> {
+    let local = state(st, s)?;
+    for (id, frame) in &s.secure_outgoing {
+        ensure!(
+            frame.0.message_id == *id && frame.0.from == urn(&st.peer),
+            "invalid outgoing frame"
+        );
+        let path = local.join(format!("queued-{id}"));
+        let bytes = serde_json::to_vec(frame)?;
+        if path.exists() {
+            let mut existing = Vec::new();
+            fs::OpenOptions::new()
+                .read(true)
+                .custom_flags(libc::O_NOFOLLOW)
+                .open(&path)?
+                .take(16 * 1024 * 1024 + 1)
+                .read_to_end(&mut existing)?;
+            ensure!(existing == bytes, "conflicting locally staged message id");
+        } else {
+            atomic(&path, &bytes)?;
+        }
+    }
+    Ok(())
+}
+pub fn project(st: &Store, s: &Snapshot) -> Result<()> {
+    ensure!(s.secure_mode, "secure session mode mismatch");
+    let w = workflow(st, s)?;
+    let local = state(st, s)?;
+    let begun = local.join("started");
+    if !begun.exists() {
+        w.ensure_session(st.peer == "a")?;
+        atomic(&begun, b"started\n")?;
+    }
+    for m in s.messages.iter().filter(|m| m.from == urn(&st.peer)) {
+        let sent = local.join(format!("sent-{}", m.message_id));
+        if !sent.exists() {
+            let queued = local.join(format!("queued-{}", m.message_id));
+            // Shared state cannot authorize a new outgoing message.
+            if !queued.exists() {
+                continue;
+            }
+            let mut bytes = Vec::new();
+            fs::OpenOptions::new()
+                .read(true)
+                .custom_flags(libc::O_NOFOLLOW)
+                .open(queued)?
+                .take(16 * 1024 * 1024 + 1)
+                .read_to_end(&mut bytes)?;
+            ensure!(bytes.len() <= 16 * 1024 * 1024, "oversized outgoing frame");
+            let (original, binding): (Envelope, String) = serde_json::from_slice(&bytes)?;
+            ensure!(
+                &original == m,
+                "shared outgoing frame changed after local authorization"
+            );
+            w.send(&original, &binding)?;
+            atomic(&sent, b"sent\n")?;
+        }
+    }
+    Ok(())
+}
+pub fn binding(s: &Snapshot, m: &Envelope) -> String {
+    fn revision(entry: &serde_json::Value) -> Option<String> {
+        entry["contract"]["revisions"].as_array()?.last()?["digest"]
+            .as_str()
+            .map(|d| format!("sha256:{}", d.strip_prefix("sha256:").unwrap_or(d)))
+    }
+    if let Some(cid) = m.body["contract_id"].as_str() {
+        return s.contracts.get(cid).and_then(revision).unwrap_or_default();
+    }
+    s.contracts
+        .values()
+        .filter_map(revision)
+        .next()
+        .unwrap_or_default()
+}
+/// Shared contract state remains cooperative. Peer messages require guardian receipts.
+pub fn visible(s: &Snapshot, peer: &str) -> Snapshot {
+    if !s.secure_mode {
+        return s.clone();
+    }
+    let mut v = s.clone();
+    let received = s
+        .secure_received
+        .get(peer)
+        .cloned()
+        .unwrap_or_else(BTreeMap::new);
+    v.messages.retain(|m| m.from == urn(peer));
+    v.messages.extend(received.into_values());
+    v.events.clear();
+    v.secure_received.clear();
+    v
+}

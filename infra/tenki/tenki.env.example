# Operator configuration only. Authenticate the Tenki CLI separately.
HACP_VM_CPU=4
HACP_VM_MEMORY_MB=8192
HACP_VM_DISK_GB=20
HACP_VM_IDLE_TIMEOUT=60m
HACP_VM_MAX_DURATION=4h
HACP_PROJECT_DIR=/srv/hacp/project
HACP_AGENT_HOME=/home/hacp-agent
HACP_GUARDIAN_USER=hacp-guard
HACP_GUARDIAN_HOME=/home/hacp-guard
HACP_GUARDIAN_MODE=standard
HACP_WASMER_VERSION=7.4.1
HACP_WASMER_PACKAGE=python/python@3.13.20
HACP_EXEC_PEER=b
HACP_EXEC_WASMER_DIR=/home/hacp-agent/.wasmer-exec
HACP_EXEC_POLICY=/etc/hacp/exec-policy.json
HACP_EXEC_AUDIT=/home/hacp-agent/exec-audit.jsonl
HACP_EXEC_STAGING=/home/hacp-agent/exec-staging
HACP_SYNC_INTERVAL=1
# HACP_STATE_DIR=/absolute/operator/state/outside/project
